<Project>

  <!--
    A package's dependency on another of ours (a ProjectReference: ShotDetector on FrameReader, FastYuv on
    ShotDetector) is a range up to the next major version, [X.Y.Z, X+1.0.0): NuGet writes only the minimum, which
    would let a later major (new API, removed members) replace the version this package was built against.
  -->
  <Target Name="_OurDependenciesUpToTheNextMajor" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)">
        <ProjectVersion>[%(ProjectVersion), $([MSBuild]::Add($([System.String]::Copy('%(ProjectVersion)').Split('.')[0]), 1)).0.0)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

  <!--
    The security analyzers' global config must be the SDK's all-rules-at-error one (Directory.Build.props). After the
    SDK's target that picks it, or after CoreCompile in a project where that target isn't imported (analyzers off).
  -->
  <Target Name="CheckSecurityAnalyzers" AfterTargets="AddGlobalAnalyzerConfigForPackage_MicrosoftCodeAnalysisNetAnalyzersSecurity;CoreCompile">
    <Error Condition="!$([System.String]::Copy('$(_GlobalAnalyzerConfigFile_MicrosoftCodeAnalysisNetAnalyzersSecurity)').EndsWith('_all_warnaserror.globalconfig')) or !Exists('$(_GlobalAnalyzerConfigFile_MicrosoftCodeAnalysisNetAnalyzersSecurity)')"
           Text="The security analyzers aren't all errors: this SDK's global config is '$(_GlobalAnalyzerConfigFile_MicrosoftCodeAnalysisNetAnalyzersSecurity)'. See docs/decisions/2026-11-06-security-analyzers.md." />
  </Target>

</Project>
