<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Microbenchmarks of the per-frame pixel work: CvResize.ResizeRows and EdgeDetector.Detect, on real frames (the
    films tools/realworld.py downloads) and a seeded synthetic set, with a SHA-256 of the outputs. README.md here.
    In ShotDetector.slnx so CI builds it (it can't rot), never packed; reaches the internals through
    src/ShotDetector's InternalsVisibleTo, so it measures the code as it is in the tree.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShotDetector\ShotDetector.csproj" />
  </ItemGroup>

</Project>
