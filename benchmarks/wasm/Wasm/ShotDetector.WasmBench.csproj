<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ShotDetection.Detect on frames from the caller, on browser-wasm under Node (benchmark.yml, README.md here): Bench.cs,
    which Native/ also runs, with the frames read from the host's file system through main.mjs. Needs the wasm-tools
    workload (dotnet workload install wasm-tools), so it is not in ShotDetector.slnx. Published with
    -p:RunAOTCompilation=true; SIMD and exception handling stay at their defaults (on).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <RootNamespace>ShotDetector.WasmBench</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Bench.cs" Link="Bench.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ShotDetector\ShotDetector.csproj" />
    <ProjectReference Include="..\..\..\src\ShotDetector.FastYuv\ShotDetector.FastYuv.csproj" />
  </ItemGroup>

</Project>
