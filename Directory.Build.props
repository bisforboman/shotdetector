<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Supply chain (issue #18): reproducible paths on CI, SourceLink to this commit, symbol packages. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>Jakob Boman</Authors>
    <Copyright>Copyright (c) Jakob Boman</Copyright>
    <PackageProjectUrl>https://github.com/bisforboman/shotdetector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bisforboman/shotdetector</RepositoryUrl>
    <!-- Local builds; releases take the version from the git tag (see .github/workflows/release.yml). -->
    <Version>0.1.0-alpha.1</Version>
    <!-- The libraries' API guard (SDK package validation): packing fails on a breaking change against this release,
         the last stable version on nuget.org (docs/decisions.md, 2026-10-08). -->
    <ApiBaselineVersion>1.3.0</ApiBaselineVersion>
  </PropertyGroup>
</Project>
