<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Supply chain (issue #18): reproducible paths on CI, SourceLink to this commit, symbol packages. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>Jakob Boman</Authors>
    <Copyright>Copyright (c) Jakob Boman</Copyright>
    <PackageProjectUrl>https://github.com/bisforboman/shotdetector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bisforboman/shotdetector</RepositoryUrl>
    <!-- Two products, each with its own version from its CHANGELOG (release.yml passes them; these are for local
         builds): ShotDetector (with FastYuv and the CLI) and FrameReader (with FrameReader.Native), which sets its own
         Version from FrameReaderVersion (docs/frame-reader-product.md). Never pass -p:Version: as a global property
         it would reach FrameReader too, through ShotDetector's reference. -->
    <ShotDetectorVersion>0.1.0-alpha.1</ShotDetectorVersion>
    <FrameReaderVersion>0.1.0-alpha.1</FrameReaderVersion>
    <Version>$(ShotDetectorVersion)</Version>
    <!-- Each product's API guard (SDK package validation): packing fails on a breaking change against its last stable
         version on nuget.org (docs/decisions/, 2026-10-08). -->
    <ApiBaselineVersion>3.28.0</ApiBaselineVersion>
    <FrameReaderApiBaselineVersion>2.22.0</FrameReaderApiBaselineVersion>
    <!-- No vulnerable package, direct or transitive, in anything this repository builds or ships: restore fails on an
         advisory of any severity, locally, in CI, at pack and at release
         (docs/decisions/2026-11-06-vulnerable-packages.md). Fix one by moving the package in Directory.Packages.props,
         never by suppressing it. NU1905 (an audit source that can't be reached) stays a warning.
         vulnerable-packages.yml checks main weekly for new advisories. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <!-- The .NET SDK's security analyzers (category Security: CA2xxx, CA3xxx, CA5xxx) run on every build of every project,
       each finding an error, not only where -warnaserror is on (docs/decisions/2026-11-06-security-analyzers.md).
       AnalysisModeSecurity=All makes the SDK add its global config enabling every Security rule; the suffix, a private
       SDK property, picks that config's variant with each rule at error (what CodeAnalysisTreatWarningsAsErrors would
       pick, but for Security only). A category line in .editorconfig can't do it: the global config's per-rule
       severities win over a category's. EnableNETAnalyzers and AnalysisLevelSecurity keep them on in a project that
       isn't net5.0 or later. CheckSecurityAnalyzers (Directory.Build.targets) fails the build if a project or an SDK
       stops honouring this. A false positive is suppressed where it is, with a justification. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevelSecurity>latest</AnalysisLevelSecurity>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <_GlobalAnalyzerConfigFileName_MicrosoftCodeAnalysisNetAnalyzersSecurity_WarnAsErrorSuffix>_warnaserror</_GlobalAnalyzerConfigFileName_MicrosoftCodeAnalysisNetAnalyzersSecurity_WarnAsErrorSuffix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StyleBro.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
