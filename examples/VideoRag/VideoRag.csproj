<Project Sdk="Microsoft.NET.Sdk">

  <!-- A sample, not a package (issue #635, docs/ideas/dataingestion-video-reader.md): a video through
       Microsoft.Extensions.DataIngestion's IngestionPipeline into an in-memory vector store, one section per shot.
       In the solution so it keeps compiling; tests/VideoRag.Tests runs its pipeline offline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- DataIngestion's enrichers and VectorData's dynamic collections are marked experimental (MEAI001, MEVD...). -->
    <NoWarn>$(NoWarn);MEAI001;MEDI001;MEVD9000;MEVD9001;SKEXP0001;SKEXP0020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShotDetector\ShotDetector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VideoRag.Tests" />
  </ItemGroup>

</Project>
