<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.6.0" />
    <!-- The GitHubActions test logger in CI: each failed test as a check-run annotation (readable via the API). -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- FFmpeg 8's bindings: 9.x binds FFmpeg 9's libraries (other struct layouts), which ours aren't. -->
    <PackageVersion Include="FFmpeg.AutoGen" Version="[8.1.0, 9.0.0)" />
    <PackageVersion Include="StyleBro.Analyzers" Version="0.8.0-alpha.1" />
    <!-- benchmarks/FrameReader.Benchmarks only -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FFMpegCore" Version="5.5.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- examples/VideoRag only (issue #635): Microsoft.Extensions.DataIngestion is preview, pinned to the version
         docs/ideas/dataingestion-video-reader.md checked; the rest is what its pipeline needs for this sample. -->
    <PackageVersion Include="Microsoft.Extensions.DataIngestion" Version="10.11.0-preview.1.26513.7" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="1.0.3" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.InMemory" Version="1.74.0-preview" />
  </ItemGroup>
</Project>
