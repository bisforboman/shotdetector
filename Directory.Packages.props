<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.5.0" />
    <!-- FFmpeg 8's bindings: 9.x binds FFmpeg 9's libraries (other struct layouts), which ours aren't. -->
    <PackageVersion Include="FFmpeg.AutoGen" Version="[8.1.0, 9.0.0)" />
    <PackageVersion Include="StyleBro.Analyzers" Version="0.7.0-alpha.1" />
    <!-- benchmarks/FrameReader.Benchmarks only -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FFMpegCore" Version="5.5.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
