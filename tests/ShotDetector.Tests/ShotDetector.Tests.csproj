<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Real source paths (not CI's /_/), so a failed test's annotation points at its file (GitHubActions logger). -->
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data/*.html;Data/oracle.txt;Data/pixels.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShotDetector\ShotDetector.csproj" />
    <ProjectReference Include="..\..\src\ShotDetector.FastYuv\ShotDetector.FastYuv.csproj" />
    <!-- Built first; the Clips fixture runs it (VideoTests.cs). -->
    <ProjectReference Include="..\ClipMaker\ClipMaker.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first; FrameInputTests runs it. -->
    <ProjectReference Include="..\FramesWithoutFfmpeg\FramesWithoutFfmpeg.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first; CliTests runs it. -->
    <ProjectReference Include="..\..\src\ShotDetector.Cli\ShotDetector.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
