<?xml version="1.0" encoding="utf-8"?>
<!--
  FrameReader.Native: every platform's FrameReader.Native.<rid> at this version, one reference for all (issue #244).
  Packed with: dotnet pack src/FrameReader.Native -p:Rid=all -p:FrameReaderVersion=X (a nuspec, not PackageReferences: the
  platform packages are packed in the same release job, so restore couldn't find them).
-->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FrameReader.Native</id>
    <version>$version$</version>
    <authors>$authors$</authors>
    <description>FFmpeg's shared libraries for FrameReader and ShotDetector on every platform: depends on FrameReader.Native.win-x64, linux-x64, linux-arm64, linux-musl-x64 and osx-arm64 at this version. A publish for one runtime (-r linux-x64) copies only that platform's libraries; reference a single FrameReader.Native.&lt;rid&gt; to keep a build small. LGPL-2.1-or-later, as FFmpeg.</description>
    <license type="expression">LGPL-2.1-or-later</license>
    <projectUrl>https://github.com/bisforboman/shotdetector</projectUrl>
    <repository type="git" url="https://github.com/bisforboman/shotdetector" />
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <tags>video audio ffmpeg native scene-detection</tags>
    <dependencies>
      <group>
        <dependency id="FrameReader.Native.win-x64" version="[$version$]" />
        <dependency id="FrameReader.Native.linux-x64" version="[$version$]" />
        <dependency id="FrameReader.Native.linux-arm64" version="[$version$]" />
        <dependency id="FrameReader.Native.linux-musl-x64" version="[$version$]" />
        <dependency id="FrameReader.Native.osx-arm64" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\icon.png" target="" />
    <file src="README.md" target="" />
    <file src="COPYING.LGPL" target="" />
  </files>
</package>
