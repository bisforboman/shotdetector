<?xml version="1.0" encoding="utf-8"?>
<!--
  ShotDetector.Native.<rid> and ShotDetector.Native, now aliases: no files, a dependency on FrameReader.Native.<rid>
  (FrameReader.Native) at FrameReader's version or newer, so references from before FrameReader.Native keep working.
  Packed with: dotnet pack src/FrameReader.Native -p:Alias=true -p:Rid=<rid or all> (FrameReader.Native.csproj sets the
  properties).
-->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$id$</id>
    <version>$version$</version>
    <authors>$authors$</authors>
    <description>Now $target$: this package only depends on it, so existing references keep working. FFmpeg's shared libraries for FrameReader and ShotDetector; reference $target$ instead. LGPL-2.1-or-later, as FFmpeg.</description>
    <license type="expression">LGPL-2.1-or-later</license>
    <projectUrl>https://github.com/bisforboman/shotdetector</projectUrl>
    <repository type="git" url="https://github.com/bisforboman/shotdetector" />
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <tags>video scene-detection shot-detection ffmpeg native</tags>
    <dependencies>
      <group>
        <dependency id="$target$" version="$frameReaderVersion$" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\icon.png" target="" />
    <file src="ShotDetector.Native.README.md" target="README.md" />
    <file src="COPYING.LGPL" target="" />
  </files>
</package>
