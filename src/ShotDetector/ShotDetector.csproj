<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Trim/AOT analyzers on, so apps using the library can publish with Native AOT. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every public member is documented (it's the package's API reference); keep it that way. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

    <PackageId>ShotDetector</PackageId>
    <Description>Shot/cut detection for video, a faithful C# port of PySceneDetect's detectors (adaptive, content, threshold, histogram, hash) with identical results. Decodes with ffmpeg (must be on PATH).</Description>
    <PackageTags>video;scene-detection;shot-detection;cut-detection;ffmpeg;pyscenedetect</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Up to 1.4.x the package carried FrameReader.dll, outside semantic versioning; its changes until then are
         accepted in CompatibilitySuppressions.xml (FrameReader.dll entries only; regenerate with
         dotnet pack src/ShotDetector -c Release -p:ApiCompatGenerateSuppressionFile=true). From 1.5.0 FrameReader is
         its own stable package and a dependency. Entries a newer baseline makes unneeded don't fail the build. -->
    <ApiCompatPermitUnnecessarySuppressions>true</ApiCompatPermitUnnecessarySuppressions>
    <!-- Local and CI builds carry the placeholder version; releases the tag's, so the assembly-version check is theirs. -->
    <NoWarn Condition="'$(Version)' == '0.1.0-alpha.1'">$(NoWarn);CP0003</NoWarn>
    <PackageValidationBaselineVersion Condition="'$(ApiBaselineVersion)' != ''">$(ApiBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT bindings to FFmpeg 8.1's libraries, for DetectionOptions.Decoder = InProcess (the libraries themselves
         come from the system, like the ffmpeg executable). -->
    <PackageReference Include="FFmpeg.AutoGen" />
  </ItemGroup>

  <ItemGroup>
    <!-- FrameReader, stable from 1.5.0: a package dependency at the same version (decisions.md, 2026-10-10). -->
    <ProjectReference Include="..\FrameReader\FrameReader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="ShotDetector.Tests" />
  </ItemGroup>

</Project>
