<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- "shotdetect", like scenedetect; ShotDetector.exe would clash with the library's ShotDetector.dll. -->
    <AssemblyName>shotdetect</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Native AOT: dotnet publish src/ShotDetector.Cli -c Release -r win-x64 (needs the MSVC C++ tools). -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShotDetector\ShotDetector.csproj" />
  </ItemGroup>

</Project>
