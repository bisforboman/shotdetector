<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs the gpl variant of FFmpeg's shared libraries (with x264) for one platform as ShotDetector.Native.Gpl.<Rid>:
      dotnet pack src/ShotDetector.Native.Gpl -p:Rid=linux-x64
    The libraries come from native/gpl-<Rid>/ at the repository root (tools/native/build-ffmpeg.sh <rid> <dir> gpl,
    the native.yml workflow's native-gpl-<rid> artifact) and go to runtimes/<Rid>/native/. Used instead of
    ShotDetector.Native.<Rid>: the same files, plus H.264 encoding.
  -->
  <PropertyGroup>
    <Rid Condition="'$(Rid)' == ''">linux-x64</Rid>
    <NativeDir>$(MSBuildThisFileDirectory)..\..\native\gpl-$(Rid)\</NativeDir>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- No code, so no dependency group for the target framework. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>ShotDetector.Native.Gpl.$(Rid)</PackageId>
    <Description>ShotDetector.Native's FFmpeg 8.1.3 libraries for $(Rid) with x264 added, so FrameReader's VideoWriter encodes H.264 in-process. GPL-2.0-or-later (x264 makes the build GPL): an app that ships with this package falls under the GPL. H.264 is also covered by Via LA's AVC patent pool. Use it instead of ShotDetector.Native.$(Rid), not with it; the build recipe is configure.txt in the package.</Description>
    <PackageTags>video;h264;x264;encoding;ffmpeg;native;gpl</PackageTags>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeDir)*" Exclude="$(NativeDir)configure.txt" Pack="true" PackagePath="runtimes\$(Rid)\native\" />
    <None Include="$(NativeDir)configure.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="COPYING.GPL" Pack="true" PackagePath="\" />
    <None Include="COPYING.dav1d" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="NeedsTheLibraries" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NativeDir)configure.txt')" Text="No libraries in $(NativeDir): build them with tools/native/build-ffmpeg.sh $(Rid) native/gpl-$(Rid) gpl, or take the native.yml artifact native-gpl-$(Rid)." />
  </Target>

</Project>
