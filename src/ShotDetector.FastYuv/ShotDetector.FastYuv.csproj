<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every public member is documented (it's the package's API reference); keep it that way. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

    <PackageId>ShotDetector.FastYuv</PackageId>
    <Description>Optional fast path for ShotDetector: a bit-exact port of FFmpeg's yuv420p to BGR conversion, so ffmpeg can send raw yuv420p and only the pixels needed are converted. About 1.7x faster on 1080p video, identical results. LGPL-2.1-or-later, as the FFmpeg code it ports.</Description>
    <PackageTags>video;scene-detection;shot-detection;ffmpeg;yuv</PackageTags>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Local and CI builds carry the placeholder version; releases the tag's, so the assembly-version check is theirs. -->
    <NoWarn Condition="'$(Version)' == '0.1.0-alpha.1'">$(NoWarn);CP0003</NoWarn>
    <PackageValidationBaselineVersion Condition="'$(ApiBaselineVersion)' != ''">$(ApiBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShotDetector\ShotDetector.csproj" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="COPYING.LGPL" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="ShotDetector.Tests" />
  </ItemGroup>

</Project>
