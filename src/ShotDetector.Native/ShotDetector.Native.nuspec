<?xml version="1.0" encoding="utf-8"?>
<!--
  ShotDetector.Native: every platform's ShotDetector.Native.<rid> at this version, one reference for all (issue #244).
  Packed with: dotnet pack src/ShotDetector.Native -p:Rid=all -p:Version=X (a nuspec, not PackageReferences: the
  platform packages are packed in the same release job, so restore couldn't find them).
-->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ShotDetector.Native</id>
    <version>$version$</version>
    <authors>$authors$</authors>
    <description>FFmpeg's shared libraries for ShotDetector and FrameReader on every platform: depends on ShotDetector.Native.win-x64, linux-x64, linux-arm64, linux-musl-x64 and osx-arm64 at this version. A publish for one runtime (-r linux-x64) copies only that platform's libraries; reference a single ShotDetector.Native.&lt;rid&gt; to keep a build small. LGPL-2.1-or-later, as FFmpeg.</description>
    <license type="expression">LGPL-2.1-or-later</license>
    <projectUrl>https://github.com/bisforboman/shotdetector</projectUrl>
    <repository type="git" url="https://github.com/bisforboman/shotdetector" />
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <tags>video scene-detection shot-detection ffmpeg native</tags>
    <dependencies>
      <group>
        <dependency id="ShotDetector.Native.win-x64" version="[$version$]" />
        <dependency id="ShotDetector.Native.linux-x64" version="[$version$]" />
        <dependency id="ShotDetector.Native.linux-arm64" version="[$version$]" />
        <dependency id="ShotDetector.Native.linux-musl-x64" version="[$version$]" />
        <dependency id="ShotDetector.Native.osx-arm64" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\icon.png" target="" />
    <file src="README.md" target="" />
    <file src="COPYING.LGPL" target="" />
  </files>
</package>
