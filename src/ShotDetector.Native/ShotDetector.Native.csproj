<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs FFmpeg's shared libraries for one platform as ShotDetector.Native.<Rid> (no code):
      dotnet pack src/ShotDetector.Native -p:Rid=linux-x64
    The libraries come from native/<Rid>/ at the repository root (tools/native/build-ffmpeg.sh, the native.yml
    workflow's artifacts) and go to runtimes/<Rid>/native/, where the loader finds them next to the app.
  -->
  <PropertyGroup>
    <Rid Condition="'$(Rid)' == ''">linux-x64</Rid>
    <NativeDir>$(MSBuildThisFileDirectory)..\..\native\$(Rid)\</NativeDir>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- No code, so no dependency group for the target framework. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>ShotDetector.Native.$(Rid)</PackageId>
    <Description>FFmpeg 8.1.3's shared libraries for $(Rid), built for decoding plus AAC, MP3 and PCM encoding and common muxers (no video encoders; yadif, fps, aspectralstats and audio filters for FrameReader's AudioFilter the only filters; zlib and dav1d for PNG and AV1 linked in), so ShotDetector decodes and probes in-process: faster and with about half the memory of the ffmpeg executable, with the same results. LGPL-2.1-or-later, as FFmpeg (dav1d: BSD-2-Clause); the build recipe is configure.txt in the package.</Description>
    <PackageTags>video;scene-detection;shot-detection;ffmpeg;native</PackageTags>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeDir)*" Exclude="$(NativeDir)configure.txt" Pack="true" PackagePath="runtimes\$(Rid)\native\" />
    <None Include="$(NativeDir)configure.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="COPYING.LGPL" Pack="true" PackagePath="\" />
    <None Include="COPYING.dav1d" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="NeedsTheLibraries" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NativeDir)configure.txt')" Text="No libraries in $(NativeDir): build them with tools/native/build-ffmpeg.sh $(Rid) native/$(Rid), or take the native.yml artifact." />
  </Target>

</Project>
